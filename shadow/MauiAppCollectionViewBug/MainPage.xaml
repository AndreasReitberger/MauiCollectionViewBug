<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppCollectionViewBug.MainPage"
    
    xmlns:viewModels="clr-namespace:MauiAppCollectionViewBug.ViewModels"
    xmlns:models="clr-namespace:MauiAppCollectionViewBug.Models"
    
    x:DataType="viewModels:MainPageViewModel"  
    >
  <CollectionView 
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="5"
            x:Name="ShortsCollection" 
            ItemsSource="{Binding Shorts, Mode=TwoWay}"
            >
        <CollectionView.ItemsLayout>
            <LinearItemsLayout 
                    Orientation="Vertical" 
                    ItemSpacing="8" 
                    />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <!-- works 
            <DataTemplate x:DataType="models:Short">
                <Border
                    Stroke="{DynamicResource BorderColor}"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeThickness="1"
                    Margin="10"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    >
                    <Label Text="{Binding Name}" />
                </Border>
            </DataTemplate>
            -->
            <!---->
            <DataTemplate x:DataType="models:Short">
                <Border
                    Stroke="{DynamicResource BorderColor}"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeThickness="1"
                    Margin="10"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Shadow="Medium"
                    >
                    <Label Text="{Binding Name}" />
                </Border>
            </DataTemplate>
            
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
